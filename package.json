    "concurrently": "^10.0.7",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1"
  }
