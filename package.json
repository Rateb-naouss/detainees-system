  "version": "1.0.0",
  "description": "نظام إدارة سجلات الموقوفين - قوى الأمن الداخلي - مركز القيادة والتحكم",
  "author": "الملازم الأول راتب نعوس",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron release server.js",
    "lint": "tsc --noEmit",
    "electron:build-main": "node scripts/build-electron.mjs",
    "electron:dev": "node scripts/dev-electron.mjs",
    "electron:start": "npm run build && npm run electron:build-main && node scripts/ensure-electron.mjs && electron .",
    "electron:pack": "npm run build && npm run electron:build-main && electron-builder --dir",
    "electron:dist": "npm run build && npm run electron:build-main && electron-builder",
    "electron:dist:win": "npm run build && npm run electron:build-main && electron-builder --win"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2canvas-pro": "^2.4.4",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.14.2",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
