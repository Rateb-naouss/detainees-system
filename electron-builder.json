{
  "appId": "lb.isf.detainees.registry",
  "productName": "نظام إدارة الموقوفين - قوى الأمن الداخلي",
  "executableName": "ISF-Detainees-System",
  "copyright": "قوى الأمن الداخلي - مركز القيادة والتحكم",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "build/icon.png",
    "build/icon.ico",
    "package.json",
    "!node_modules/**"
  ],
  "electronLanguages": ["ar", "en-US"],
  "asarUnpack": [
    "dist-electron/sql-wasm.wasm",
    "build/icon.ico",
    "build/icon.png"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "artifactName": "ISF-Detainees-System-Setup-${version}.${ext}",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeaderIcon": "build/icon.ico",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "نظام إدارة الموقوفين"
  },
  "portable": {
    "artifactName": "ISF-Detainees-System-Portable-${version}.${ext}"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "build/icon.png",
    "category": "Office"
  },
  "mac": {
    "target": ["dmg"],
    "icon": "build/icon.png",
    "category": "public.app-category.utilities"
  }
}
